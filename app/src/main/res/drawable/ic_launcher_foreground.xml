<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- appleBlue -->
    <path android:pathData="M 256,60 L 90,360 L 175,360 L 256,190 L 337,360 L 422,360 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startY="0"
                android:startX="256"
                android:endY="512"
                android:endX="256"
                android:type="linear">
                <item android:offset="0" android:color="#2B7CBE" />
                <item android:offset="1" android:color="#0B2347" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- silverNode crossbar -->
    <path
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:pathData="M 178,270 L 334,270">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startY="270"
                android:startX="178"
                android:endY="270"
                android:endX="334"
                android:type="linear">
                <item android:offset="0" android:color="#F8FAFC" />
                <item android:offset="1" android:color="#CBD5E1" />
            </gradient>
        </aapt:attr>
    </path>
    
    <path android:pathData="M 178,256 A 14,14 0 1,0 178,284 A 14,14 0 1,0 178,256 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startY="256"
                android:startX="164"
                android:endY="284"
                android:endX="192"
                android:type="linear">
                <item android:offset="0" android:color="#F8FAFC" />
                <item android:offset="1" android:color="#CBD5E1" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M 334,256 A 14,14 0 1,0 334,284 A 14,14 0 1,0 334,256 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startY="256"
                android:startX="320"
                android:endY="284"
                android:endX="348"
                android:type="linear">
                <item android:offset="0" android:color="#F8FAFC" />
                <item android:offset="1" android:color="#CBD5E1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
