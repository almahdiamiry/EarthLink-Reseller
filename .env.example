# FIREBASE_CONFIGS: Credentials for connecting to your specific Firebase instance.
# Configure these securely via the Secrets panel in AI Studio.
FIREBASE_API_KEY=DummyFirebaseApiKey_replace_me
FIREBASE_APPLICATION_ID=1:1234567890:android:abcdef1234567890
FIREBASE_PROJECT_ID=dummy-project-id
FIREBASE_DATABASE_URL=https://dummy-project-id-default-rtdb.firebaseio.com

# RELEASE SIGNING CONFIGURATION:
